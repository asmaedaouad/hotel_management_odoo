<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Report Action -->
    <record id="action_report_hotel_reservation" model="ir.actions.report">
        <field name="name">Reservation Voucher</field>
        <field name="model">hotel.reservation</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">hotel_management.report_reservation_document</field>
        <field name="report_file">hotel_management.report_reservation_document</field>
        <field name="binding_model_id" ref="model_hotel_reservation"/>
        <field name="binding_type">report</field>
    </record>

    <!-- Report Template -->
    <template id="report_reservation_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Reservation Voucher</h2>
                        <div class="row mt32 mb32">
                            <div class="col-6">
                                <strong>Reservation Number:</strong>
                                <p t-field="o.name"/>
                            </div>
                            <div class="col-6">
                                <strong>Status:</strong>
                                <p t-field="o.state"/>
                            </div>
                        </div>
                        
                        <h4>Customer Information</h4>
                        <div class="row">
                            <div class="col-6">
                                <strong>Name:</strong>
                                <p t-field="o.customer_id.name"/>
                                <strong>Email:</strong>
                                <p t-field="o.email"/>
                                <strong>Phone:</strong>
                                <p t-field="o.phone"/>
                            </div>
                        </div>
                        
                        <h4>Reservation Details</h4>
                        <table class="table table-sm">
                            <tr>
                                <td><strong>Room:</strong></td>
                                <td><span t-field="o.room_id.name"/></td>
                            </tr>
                            <tr>
                                <td><strong>Check-in Date:</strong></td>
                                <td><span t-field="o.check_in_date"/></td>
                            </tr>
                            <tr>
                                <td><strong>Check-out Date:</strong></td>
                                <td><span t-field="o.check_out_date"/></td>
                            </tr>
                            <tr>
                                <td><strong>Number of Nights:</strong></td>
                                <td><span t-field="o.nights"/></td>
                            </tr>
                            <tr>
                                <td><strong>Guests:</strong></td>
                                <td><span t-field="o.adults"/> Adults, <span t-field="o.children"/> Children</td>
                            </tr>
                        </table>
                        
                        <h4>Pricing</h4>
                        <table class="table table-sm">
                            <tr>
                                <td><strong>Price per Night:</strong></td>
                                <td class="text-right"><span t-field="o.price_per_night" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td>
                            </tr>
                            <tr>
                                <td><strong>Subtotal:</strong></td>
                                <td class="text-right"><span t-field="o.subtotal" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td>
                            </tr>
                            <tr>
                                <td><strong>Tax:</strong></td>
                                <td class="text-right"><span t-field="o.tax_amount" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td>
                            </tr>
                            <tr class="border-black">
                                <td><strong>Total Amount:</strong></td>
                                <td class="text-right"><strong><span t-field="o.total_amount" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></strong></td>
                            </tr>
                        </table>
                        
                        <div t-if="o.special_requests" class="mt32">
                            <h4>Special Requests</h4>
                            <p t-field="o.special_requests"/>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>

