<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- Room Amenities -->
        <record id="amenity_wifi" model="hotel.amenity">
            <field name="name">WiFi</field>
            <field name="icon">fa-wifi</field>
            <field name="description">High-speed wireless internet</field>
        </record>

        <record id="amenity_ac" model="hotel.amenity">
            <field name="name">Air Conditioning</field>
            <field name="icon">fa-snowflake-o</field>
            <field name="description">Climate control air conditioning</field>
        </record>

        <record id="amenity_tv" model="hotel.amenity">
            <field name="name">TV</field>
            <field name="icon">fa-television</field>
            <field name="description">Flat screen TV with cable channels</field>
        </record>

        <record id="amenity_minibar" model="hotel.amenity">
            <field name="name">Mini Bar</field>
            <field name="icon">fa-glass</field>
            <field name="description">Stocked mini refrigerator</field>
        </record>

        <record id="amenity_safe" model="hotel.amenity">
            <field name="name">Safe</field>
            <field name="icon">fa-lock</field>
            <field name="description">In-room safe</field>
        </record>

        <record id="amenity_balcony" model="hotel.amenity">
            <field name="name">Balcony</field>
            <field name="icon">fa-building</field>
            <field name="description">Private balcony</field>
        </record>

        <record id="amenity_bathtub" model="hotel.amenity">
            <field name="name">Bathtub</field>
            <field name="icon">fa-bath</field>
            <field name="description">Bathtub in bathroom</field>
        </record>

        <record id="amenity_shower" model="hotel.amenity">
            <field name="name">Shower</field>
            <field name="icon">fa-shower</field>
            <field name="description">Walk-in shower</field>
        </record>

        <record id="amenity_hairdryer" model="hotel.amenity">
            <field name="name">Hair Dryer</field>
            <field name="icon">fa-fire</field>
            <field name="description">Hair dryer</field>
        </record>

        <record id="amenity_coffee" model="hotel.amenity">
            <field name="name">Coffee Maker</field>
            <field name="icon">fa-coffee</field>
            <field name="description">In-room coffee/tea maker</field>
        </record>

        <record id="amenity_desk" model="hotel.amenity">
            <field name="name">Work Desk</field>
            <field name="icon">fa-desktop</field>
            <field name="description">Work desk with chair</field>
        </record>

        <record id="amenity_phone" model="hotel.amenity">
            <field name="name">Telephone</field>
            <field name="icon">fa-phone</field>
            <field name="description">Direct dial telephone</field>
        </record>

        <record id="amenity_iron" model="hotel.amenity">
            <field name="name">Iron &amp; Ironing Board</field>
            <field name="icon">fa-wrench</field>
            <field name="description">Iron and ironing board</field>
        </record>

        <record id="amenity_slippers" model="hotel.amenity">
            <field name="name">Slippers</field>
            <field name="icon">fa-user</field>
            <field name="description">Complimentary slippers</field>
        </record>

        <record id="amenity_toiletries" model="hotel.amenity">
            <field name="name">Toiletries</field>
            <field name="icon">fa-shopping-bag</field>
            <field name="description">Complimentary toiletries</field>
        </record>

    </data>
</odoo>

