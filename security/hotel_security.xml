<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        
        <!-- Hotel Management Categories -->
        <record id="module_category_hotel_management" model="ir.module.category">
            <field name="name">Hotel Management</field>
            <field name="description">Manage hotel operations and reservations</field>
            <field name="sequence">10</field>
        </record>

        <!-- Hotel User Group -->
        <record id="group_hotel_user" model="res.groups">
            <field name="name">Hotel User</field>
            <field name="category_id" ref="module_category_hotel_management"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">User can view hotel information and create reservations</field>
        </record>

        <!-- Hotel Receptionist Group -->
        <record id="group_hotel_receptionist" model="res.groups">
            <field name="name">Hotel Receptionist</field>
            <field name="category_id" ref="module_category_hotel_management"/>
            <field name="implied_ids" eval="[(4, ref('group_hotel_user'))]"/>
            <field name="comment">Receptionist can manage reservations, check-ins, and check-outs</field>
        </record>

        <!-- Hotel Manager Group -->
        <record id="group_hotel_manager" model="res.groups">
            <field name="name">Hotel Manager</field>
            <field name="category_id" ref="module_category_hotel_management"/>
            <field name="implied_ids" eval="[(4, ref('group_hotel_receptionist'))]"/>
            <field name="comment">Manager has full access to hotel management</field>
        </record>

        <!-- Record Rules -->
        
        <!-- Reservation Rules -->
        <record id="hotel_reservation_user_rule" model="ir.rule">
            <field name="name">Hotel Reservation: User - Own Reservations</field>
            <field name="model_id" ref="model_hotel_reservation"/>
            <field name="domain_force">[('create_uid', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_hotel_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="hotel_reservation_receptionist_rule" model="ir.rule">
            <field name="name">Hotel Reservation: Receptionist - All Reservations</field>
            <field name="model_id" ref="model_hotel_reservation"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_hotel_receptionist'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="hotel_reservation_manager_rule" model="ir.rule">
            <field name="name">Hotel Reservation: Manager - All Access</field>
            <field name="model_id" ref="model_hotel_reservation"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_hotel_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

    </data>
</odoo>

