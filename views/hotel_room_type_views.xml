<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Room Type Tree View -->
    <record id="view_hotel_room_type_tree" model="ir.ui.view">
        <field name="name">hotel.room.type.tree</field>
        <field name="model">hotel.room.type</field>
        <field name="arch" type="xml">
            <tree string="Room Types">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="capacity"/>
                <field name="bed_type"/>
                <field name="base_price" widget="monetary"/>
                <field name="room_count"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <!-- Room Type Form View -->
    <record id="view_hotel_room_type_form" model="ir.ui.view">
        <field name="name">hotel.room.type.form</field>
        <field name="model">hotel.room.type</field>
        <field name="arch" type="xml">
            <form string="Room Type">
                <sheet>
                    <field name="image" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Room Type Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="sequence"/>
                            <field name="capacity"/>
                            <field name="bed_type"/>
                        </group>
                        <group>
                            <field name="base_price" widget="monetary"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="size"/>
                            <field name="room_count"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description" widget="html"/>
                        </page>
                        <page string="Amenities">
                            <field name="amenity_ids" widget="many2many_tags"/>
                        </page>
                        <page string="Rooms">
                            <field name="room_ids">
                                <tree>
                                    <field name="room_number"/>
                                    <field name="floor"/>
                                    <field name="state" widget="badge"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Room Type Kanban View -->
    <record id="view_hotel_room_type_kanban" model="ir.ui.view">
        <field name="name">hotel.room.type.kanban</field>
        <field name="model">hotel.room.type</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="id"/>
                <field name="name"/>
                <field name="base_price"/>
                <field name="capacity"/>
                <field name="image"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_image">
                                <img t-att-src="kanban_image('hotel.room.type', 'image', record.id.raw_value)" alt="Room Type"/>
                            </div>
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title"><field name="name"/></strong>
                                <div class="o_kanban_record_subtitle">
                                    <field name="code"/> - <field name="capacity"/> persons
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <field name="base_price" widget="monetary"/>
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <field name="room_count"/> rooms
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Room Type Action -->
    <record id="action_hotel_room_type" model="ir.actions.act_window">
        <field name="name">Room Types</field>
        <field name="res_model">hotel.room.type</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first room type
            </p>
            <p>
                Define different types of rooms available in your hotel.
            </p>
        </field>
    </record>

</odoo>

