<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Folio Tree View -->
    <record id="view_hotel_folio_tree" model="ir.ui.view">
        <field name="name">hotel.folio.tree</field>
        <field name="model">hotel.folio</field>
        <field name="arch" type="xml">
            <tree string="Folios">
                <field name="name"/>
                <field name="date"/>
                <field name="customer_id"/>
                <field name="room_id"/>
                <field name="total_amount" widget="monetary"/>
                <field name="amount_due" widget="monetary"/>
                <field name="state" widget="badge" 
                       decoration-success="state=='paid'"
                       decoration-info="state=='open'"/>
            </tree>
        </field>
    </record>

    <!-- Folio Form View -->
    <record id="view_hotel_folio_form" model="ir.ui.view">
        <field name="name">hotel.folio.form</field>
        <field name="model">hotel.folio</field>
        <field name="arch" type="xml">
            <form string="Folio">
                <header>
                    <button name="action_confirm" string="Confirm" 
                            type="object" class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_mark_paid" string="Mark as Paid" 
                            type="object" class="oe_highlight"
                            invisible="state != 'open'"/>
                    <button name="action_cancel" string="Cancel" 
                            type="object" 
                            invisible="state in ['paid', 'cancelled']"/>
                    <field name="state" widget="statusbar" 
                           statusbar_visible="draft,open,paid"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="reservation_id"/>
                            <field name="customer_id"/>
                            <field name="room_id"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Folio Lines">
                            <field name="line_ids">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="date"/>
                                    <field name="description"/>
                                    <field name="quantity"/>
                                    <field name="price_unit" widget="monetary"/>
                                    <field name="subtotal" widget="monetary"/>
                                    <field name="tax_rate"/>
                                    <field name="tax_amount" widget="monetary"/>
                                    <field name="total" widget="monetary"/>
                                    <field name="currency_id" invisible="1"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="notes" placeholder="Additional notes..."/>
                        </page>
                    </notebook>
                    <group class="oe_subtotal_footer oe_right">
                        <field name="subtotal" widget="monetary"/>
                        <field name="tax_amount" widget="monetary"/>
                        <div class="oe_subtotal_footer_separator oe_inline">
                            <label for="total_amount"/>
                            <field name="total_amount" nolabel="1" class="oe_subtotal_footer_separator" widget="monetary"/>
                        </div>
                        <field name="amount_paid" widget="monetary"/>
                        <div class="oe_subtotal_footer_separator oe_inline">
                            <label for="amount_due" string="Balance Due"/>
                            <field name="amount_due" nolabel="1" class="oe_subtotal_footer_separator" widget="monetary"/>
                        </div>
                    </group>
                    <div class="oe_clear"/>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Folio Action -->
    <record id="action_hotel_folio" model="ir.actions.act_window">
        <field name="name">Folios</field>
        <field name="res_model">hotel.folio</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first folio
            </p>
            <p>
                Manage guest bills and invoices.
            </p>
        </field>
    </record>

</odoo>

