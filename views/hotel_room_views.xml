<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Room Tree View -->
    <record id="view_hotel_room_tree" model="ir.ui.view">
        <field name="name">hotel.room.tree</field>
        <field name="model">hotel.room</field>
        <field name="arch" type="xml">
            <tree string="Rooms" decoration-success="state=='available'" 
                  decoration-danger="state=='maintenance'" 
                  decoration-warning="state=='cleaning'"
                  decoration-info="state=='reserved'">
                <field name="room_number"/>
                <field name="room_type_id"/>
                <field name="floor"/>
                <field name="capacity"/>
                <field name="base_price" widget="monetary"/>
                <field name="state" widget="badge" 
                       decoration-success="state=='available'"
                       decoration-danger="state=='maintenance'"
                       decoration-warning="state=='cleaning'"
                       decoration-info="state=='reserved'"
                       decoration-muted="state=='occupied'"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <!-- Room Form View -->
    <record id="view_hotel_room_form" model="ir.ui.view">
        <field name="name">hotel.room.form</field>
        <field name="model">hotel.room</field>
        <field name="arch" type="xml">
            <form string="Room">
                <header>
                    <button name="action_set_available" string="Set Available" 
                            type="object" class="oe_highlight"
                            invisible="state == 'available'"/>
                    <button name="action_set_maintenance" string="Maintenance" 
                            type="object" 
                            invisible="state == 'maintenance'"/>
                    <button name="action_set_cleaning" string="Cleaning" 
                            type="object" 
                            invisible="state == 'cleaning'"/>
                    <button name="action_view_reservations" string="View Reservations" 
                            type="object" class="oe_highlight"/>
                    <field name="state" widget="statusbar" 
                           statusbar_visible="available,reserved,occupied,cleaning"/>
                </header>
                <sheet>
                    <field name="image" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <h1>
                            <field name="room_number" placeholder="Room Number"/>
                        </h1>
                        <h2>
                            <field name="name" readonly="1"/>
                        </h2>
                    </div>
                    <group>
                        <group>
                            <field name="room_type_id"/>
                            <field name="floor"/>
                            <field name="capacity"/>
                        </group>
                        <group>
                            <field name="base_price" widget="monetary"/>
                            <field name="is_available"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description" widget="html"/>
                        </page>
                        <page string="Additional Amenities">
                            <field name="amenity_ids" widget="many2many_tags"/>
                        </page>
                        <page string="Reservations">
                            <field name="reservation_ids">
                                <tree>
                                    <field name="name"/>
                                    <field name="customer_id"/>
                                    <field name="check_in_date"/>
                                    <field name="check_out_date"/>
                                    <field name="state" widget="badge"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="notes" placeholder="Internal notes about this room..."/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Room Kanban View -->
    <record id="view_hotel_room_kanban" model="ir.ui.view">
        <field name="name">hotel.room.kanban</field>
        <field name="model">hotel.room</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state">
                <field name="id"/>
                <field name="room_number"/>
                <field name="room_type_id"/>
                <field name="state"/>
                <field name="image"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_image">
                                <img t-att-src="kanban_image('hotel.room', 'image', record.id.raw_value)" alt="Room"/>
                            </div>
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    Room <field name="room_number"/>
                                </strong>
                                <div class="o_kanban_record_subtitle">
                                    <field name="room_type_id"/>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        Floor: <field name="floor"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Room Action -->
    <record id="action_hotel_room" model="ir.actions.act_window">
        <field name="name">Rooms</field>
        <field name="res_model">hotel.room</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first room
            </p>
            <p>
                Add rooms to your hotel inventory.
            </p>
        </field>
    </record>

</odoo>

