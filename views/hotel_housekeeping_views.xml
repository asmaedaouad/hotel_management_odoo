<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Housekeeping Tree View -->
    <record id="view_hotel_housekeeping_tree" model="ir.ui.view">
        <field name="name">hotel.housekeeping.tree</field>
        <field name="model">hotel.housekeeping</field>
        <field name="arch" type="xml">
            <tree string="Housekeeping Tasks" decoration-danger="priority=='3'" decoration-warning="priority=='2'">
                <field name="name"/>
                <field name="room_number"/>
                <field name="floor"/>
                <field name="task_type"/>
                <field name="scheduled_date"/>
                <field name="assigned_to"/>
                <field name="priority" widget="priority"/>
                <field name="state" widget="badge" 
                       decoration-info="state=='in_progress'"
                       decoration-success="state=='completed'"/>
            </tree>
        </field>
    </record>

    <!-- Housekeeping Form View -->
    <record id="view_hotel_housekeeping_form" model="ir.ui.view">
        <field name="name">hotel.housekeeping.form</field>
        <field name="model">hotel.housekeeping</field>
        <field name="arch" type="xml">
            <form string="Housekeeping Task">
                <header>
                    <button name="action_start" string="Start" 
                            type="object" class="oe_highlight"
                            invisible="state != 'pending'"/>
                    <button name="action_complete" string="Complete" 
                            type="object" class="oe_highlight"
                            invisible="state != 'in_progress'"/>
                    <button name="action_cancel" string="Cancel" 
                            type="object" 
                            invisible="state in ['completed', 'cancelled']"/>
                    <field name="state" widget="statusbar" 
                           statusbar_visible="pending,in_progress,completed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="room_id"/>
                            <field name="room_number"/>
                            <field name="floor"/>
                            <field name="task_type"/>
                        </group>
                        <group>
                            <field name="scheduled_date"/>
                            <field name="scheduled_time" widget="float_time"/>
                            <field name="assigned_to"/>
                            <field name="priority" widget="priority"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="start_time" readonly="1"/>
                            <field name="end_time" readonly="1"/>
                            <field name="duration" readonly="1"/>
                        </group>
                        <group>
                            <field name="reservation_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Checklist">
                            <field name="checklist_ids">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="completed" widget="boolean_toggle"/>
                                    <field name="notes"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="notes" placeholder="Additional notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Housekeeping Kanban View -->
    <record id="view_hotel_housekeeping_kanban" model="ir.ui.view">
        <field name="name">hotel.housekeeping.kanban</field>
        <field name="model">hotel.housekeeping</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state">
                <field name="name"/>
                <field name="room_number"/>
                <field name="task_type"/>
                <field name="priority"/>
                <field name="assigned_to"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    Room <field name="room_number"/>
                                </strong>
                                <div class="o_kanban_record_subtitle">
                                    <field name="task_type"/>
                                </div>
                                <div class="o_kanban_record_subtitle">
                                    <field name="scheduled_date"/>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <field name="priority" widget="priority"/>
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <field name="assigned_to" widget="many2one_avatar_user"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Housekeeping Action -->
    <record id="action_hotel_housekeeping" model="ir.actions.act_window">
        <field name="name">Housekeeping</field>
        <field name="res_model">hotel.housekeeping</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first housekeeping task
            </p>
            <p>
                Manage room cleaning and maintenance tasks.
            </p>
        </field>
    </record>

</odoo>

