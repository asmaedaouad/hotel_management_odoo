<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Customer Tree View -->
    <record id="view_hotel_customer_tree" model="ir.ui.view">
        <field name="name">hotel.customer.tree</field>
        <field name="model">hotel.customer</field>
        <field name="arch" type="xml">
            <tree string="Customers">
                <field name="name"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="customer_type"/>
                <field name="reservation_count"/>
                <field name="total_spent" widget="monetary"/>
                <field name="vip" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <!-- Customer Form View -->
    <record id="view_hotel_customer_form" model="ir.ui.view">
        <field name="name">hotel.customer.form</field>
        <field name="model">hotel.customer</field>
        <field name="arch" type="xml">
            <form string="Customer">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_reservations" type="object" 
                                class="oe_stat_button" icon="fa-calendar">
                            <field name="reservation_count" widget="statinfo" string="Reservations"/>
                        </button>
                    </div>
                    <field name="vip" widget="boolean_toggle"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Customer Name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Contact Information">
                            <field name="email" widget="email"/>
                            <field name="phone" widget="phone"/>
                            <field name="mobile" widget="phone"/>
                        </group>
                        <group string="Customer Type">
                            <field name="customer_type"/>
                            <field name="company_name" invisible="customer_type != 'corporate'"/>
                            <field name="partner_id"/>
                        </group>
                    </group>
                    <group>
                        <group string="Personal Information">
                            <field name="date_of_birth"/>
                            <field name="gender"/>
                            <field name="nationality"/>
                        </group>
                        <group string="Identification">
                            <field name="id_type"/>
                            <field name="id_number"/>
                            <field name="id_expiry_date"/>
                        </group>
                    </group>
                    <group string="Address">
                        <group>
                            <field name="street" placeholder="Street..."/>
                            <field name="street2" placeholder="Street 2..."/>
                            <field name="city" placeholder="City"/>
                        </group>
                        <group>
                            <field name="state_id" placeholder="State"/>
                            <field name="zip" placeholder="ZIP"/>
                            <field name="country_id" placeholder="Country"/>
                        </group>
                    </group>
                    <group>
                        <group string="Statistics">
                            <field name="total_spent" widget="monetary"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Special Requests">
                            <field name="special_requests" placeholder="Customer preferences and special requests..."/>
                        </page>
                        <page string="Reservations">
                            <field name="reservation_ids">
                                <tree>
                                    <field name="name"/>
                                    <field name="check_in_date"/>
                                    <field name="check_out_date"/>
                                    <field name="room_id"/>
                                    <field name="total_amount" widget="monetary"/>
                                    <field name="state" widget="badge"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Internal Notes">
                            <field name="notes" placeholder="Internal notes about this customer..."/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Customer Kanban View -->
    <record id="view_hotel_customer_kanban" model="ir.ui.view">
        <field name="name">hotel.customer.kanban</field>
        <field name="model">hotel.customer</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="id"/>
                <field name="name"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="vip"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                    <span t-if="record.vip.raw_value" class="badge badge-warning">VIP</span>
                                </strong>
                                <div class="o_kanban_record_subtitle">
                                    <field name="email"/>
                                </div>
                                <div class="o_kanban_record_subtitle">
                                    <field name="phone"/>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <field name="reservation_count"/> reservations
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <field name="total_spent" widget="monetary"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Customer Action -->
    <record id="action_hotel_customer" model="ir.actions.act_window">
        <field name="name">Customers</field>
        <field name="res_model">hotel.customer</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first customer
            </p>
            <p>
                Manage your hotel customers and their information.
            </p>
        </field>
    </record>

</odoo>

