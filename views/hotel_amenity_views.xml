<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Amenity Tree View -->
    <record id="view_hotel_amenity_tree" model="ir.ui.view">
        <field name="name">hotel.amenity.tree</field>
        <field name="model">hotel.amenity</field>
        <field name="arch" type="xml">
            <tree string="Amenities">
                <field name="name"/>
                <field name="icon"/>
                <field name="description"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <!-- Amenity Form View -->
    <record id="view_hotel_amenity_form" model="ir.ui.view">
        <field name="name">hotel.amenity.form</field>
        <field name="model">hotel.amenity</field>
        <field name="arch" type="xml">
            <form string="Amenity">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Amenity Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="icon" placeholder="e.g., fa-wifi"/>
                        </group>
                        <group>
                            <field name="active"/>
                        </group>
                    </group>
                    <group>
                        <field name="description" placeholder="Description of the amenity..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Amenity Action -->
    <record id="action_hotel_amenity" model="ir.actions.act_window">
        <field name="name">Amenities</field>
        <field name="res_model">hotel.amenity</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first amenity
            </p>
            <p>
                Define amenities available in your hotel rooms.
            </p>
        </field>
    </record>

</odoo>

